#!/usr/bin/env bash
# Pre-commit hook for Mimic
# Ensures property metadata-generated code is current before committing.
# Fails fast if drift is detected; instructs developer how to regenerate.

set -euo pipefail

echo "[pre-commit] Verifying generated property code is up-to-date..."

# Infer the active model from the regeneration hint embedded in the generated
# property header.  The header contains a line like:
#   * To regenerate: make MODEL=sage generate
PROP_DEFS="src/include/generated/property_defs.h"
if [ ! -f "${PROP_DEFS}" ]; then
  echo "[pre-commit] ${PROP_DEFS} not found — run: make MODEL=<name> generate" >&2
  exit 1
fi

MODEL=$(sed -n 's/.* make MODEL=\([^ ]*\) generate.*/\1/p' "${PROP_DEFS}" | head -1)
if [ -z "${MODEL}" ]; then
  echo "[pre-commit] Cannot determine active MODEL from ${PROP_DEFS}." >&2
  echo "[pre-commit] Run: make MODEL=<name> generate && git add src/include/generated" >&2
  exit 1
fi

echo "[pre-commit] Active model: ${MODEL}"
export MODEL

# Run the checker quietly; capture output
if ! python3 scripts/check_generated.py > /dev/null 2>&1 ; then
  echo "[pre-commit] Detected out-of-date generated files." >&2
  echo "[pre-commit] Run: make MODEL=${MODEL} generate" >&2
  echo "[pre-commit] Then add and re-commit." >&2
  exit 1
fi

echo "[pre-commit] Generated property code is current."
exit 0
