# An instability burst (mode 1): eburst is the unstable gas fraction itself (M:600-601), the stars
# go to the instability bulge (burst_to_merger_bulge 0), no recheck (mode 1), the yield stays in
# the disk (ratio < 0.3 and ColdGas > 1e-8).
# Reachability: R0-reachable.
format sage26-oracle-fixture 1
routine collisional_starburst_recipe

i32 params.SFprescription 0  # R0 (R0.par:48)
i32 params.SupernovaRecipeOn 1  # R0 (R0.par:50)
