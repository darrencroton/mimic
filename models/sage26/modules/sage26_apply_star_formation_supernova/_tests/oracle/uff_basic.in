# A burst's reheated 0.1 and ejected 0.05 on a central: no clamp or cap binds.
# Constructed input (not R0 output); every value is set explicitly. All flags and parameters are
# R0's unless a line says NOT R0.
format sage26-oracle-fixture 1
routine update_from_feedback

i32 params.SFprescription 0  # R0
i32 params.SupernovaRecipeOn 1  # R0
i32 params.CGMrecipeOn 0  # R0
i32 call.ngal 1
i32 call.p 0  # the bursting galaxy (merger_centralgal)
i32 call.centralgal 0  # the FoF central
f64 call.reheated_mass 0x3fb999999999999a  # 0.1
f64 call.ejected_mass 0x3fa999999999999a  # 0.05

i32 galaxy[0].Type 0
f32 galaxy[0].ColdGas 0x40000000  # 2
f32 galaxy[0].MetalsColdGas 0x3cf5c28f  # 0.0299999993
f32 galaxy[0].StellarMass 0x40a00000  # 5
f32 galaxy[0].MetalsStellarMass 0x3da3d70a  # 0.0799999982
f32 galaxy[0].BulgeMass 0x3f800000  # 1
f32 galaxy[0].MetalsBulgeMass 0x3ca3d70a  # 0.0199999996
f32 galaxy[0].InstabilityBulgeMass 0x3f000000  # 0.5
f32 galaxy[0].HotGas 0x41a00000  # 20
f32 galaxy[0].MetalsHotGas 0x3e4ccccd  # 0.200000003
f32 galaxy[0].EjectedMass 0x40400000  # 3
f32 galaxy[0].MetalsEjectedMass 0x3cf5c28f  # 0.0299999993
f32 galaxy[0].H1gas 0x3e000000  # 0.125
f32 galaxy[0].H2gas 0x00000000  # 0
f32 galaxy[0].OutflowRate 0x3d800000  # 0.0625
