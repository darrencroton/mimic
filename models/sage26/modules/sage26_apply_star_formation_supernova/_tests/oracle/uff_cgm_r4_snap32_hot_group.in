# update_from_feedback (S:1146-1251) as a burst calls it, with R4's flags, for the satellite of a
# real R4 FoF group at Snap_32, a hot-regime group (central Regime 1, both pairs non-empty) whose
# satellite is in the CGM regime: the hot pair of the central is selected.
# End-of-snapshot output values of the R4 reference output,
# /Volumes/Internal/results/sage26-campaign/workspace/e01-reference/out/R4/model_0.hdf5 (SHA-256
# 2b606ee7ac82559e32c7c91161f1edb44f89288ec57016e80da884e118ed0807), used as plausible call inputs,
# not reconstructed call-time state: the writer's verbatim floats, DiskScaleRadius the output's
# DiskRadius, MassLoading the stale value SAGE26 left (the FIRE path overwrites it), Regime the
# classifier's. Constructed: OutflowRate 0 (its value at substep 0 after the first-occupied reset,
# R/src/core_build_model.c:276) and zero histories, as at substep 0; the timing is the c05 R0
# templates' (c03's Age values). Each galaxy's stored SnapNum is the output snapshot and ZZ[SnapNum]
# SAGE26's 1/AA - 1.
# Constructed: the reheated mass, 0.3 of the satellite's cold gas, and the ejected mass, 0.1 of it.
# galaxy 0: R4 Snap_32 row 70 (GalaxyIndex 182, Type 0, Regime 1)
# galaxy 1: R4 Snap_32 row 71 (GalaxyIndex 197, Type 1, Regime 0)
# Reachability: R4-reachable.
# R4's flags (par/R4.par): CGMrecipeOn 1 (:54), FIREmodeOn 1 (:55), SFprescription 1 (:48),
# BulgeSizeOn 3 (:109), SupernovaRecipeOn 1 (:50), DiskInstabilityOn 1 (:52), AGNrecipeOn 2 (:49);
# every other parameter R3's (R4.par differs from R3.par only at :7 and :54).
format sage26-oracle-fixture 1
routine update_from_feedback

i32 params.SFprescription 1  # R4.par:48: BR06 with radial integration
i32 params.H2RadialIntegrationOn 1  # SAGE26's default, R/src/core_read_parameter_file.c:99; R4.par does not set it
i32 params.H2RadialNBins 25  # default, R/src/core_read_parameter_file.c:100
f64 params.H2RadialRMaxFactor 0x4014000000000000  # 5.0  (default, R/src/core_read_parameter_file.c:101)
i32 params.StarburstColdGasOn 1  # default, R/src/core_read_parameter_file.c:109; required with SFprescription 1
i32 params.SupernovaRecipeOn 1  # R4.par:50
i32 params.CGMrecipeOn 1  # R4.par:54
i32 call.ngal 2
i32 call.p 1  # the galaxy whose cold gas is reheated
i32 call.centralgal 0  # the FoF central
f64 call.reheated_mass 0x3fc1d05199999999  # 0.13916988372802733
f64 call.ejected_mass 0x3fa7c06ccccccccd  # 0.04638996124267578

i32 galaxy[0].Type 0
f32 galaxy[0].ColdGas 0x00000000  # 0
f32 galaxy[0].MetalsColdGas 0x00000000  # 0
f32 galaxy[0].StellarMass 0x3d9b04e7  # 0.0756929442
f32 galaxy[0].MetalsStellarMass 0x3952cd12  # 0.000201035553
f32 galaxy[0].BulgeMass 0x3d0ed3f2  # 0.0348700956
f32 galaxy[0].MetalsBulgeMass 0x3888462b  # 6.49805515e-05
f32 galaxy[0].InstabilityBulgeMass 0x37f225ff  # 2.88663414e-05
f32 galaxy[0].HotGas 0x41c6b99c  # 24.8406296
f32 galaxy[0].MetalsHotGas 0x3cdad5aa  # 0.0267132111
f32 galaxy[0].EjectedMass 0x3e8707b6  # 0.263730705
f32 galaxy[0].MetalsEjectedMass 0x3a993804  # 0.00116896676
f32 galaxy[0].H1gas 0x00000000  # 0
f32 galaxy[0].H2gas 0x00000000  # 0
f32 galaxy[0].OutflowRate 0x00000000  # 0
i32 galaxy[0].Regime 1
f32 galaxy[0].CGMgas 0x3e1cf0e3  # 0.15326266
f32 galaxy[0].MetalsCGMgas 0x3001a813  # 4.71687744e-10

i32 galaxy[1].Type 1
f32 galaxy[1].ColdGas 0x3eed8440  # 0.463899612
f32 galaxy[1].MetalsColdGas 0x3bc88001  # 0.00611877488
f32 galaxy[1].StellarMass 0x3f91ad7a  # 1.13810658
f32 galaxy[1].MetalsStellarMass 0x3c0ae3bb  # 0.00847714674
f32 galaxy[1].BulgeMass 0x3db64485  # 0.0889978781
f32 galaxy[1].MetalsBulgeMass 0x3a338890  # 0.00068486575
f32 galaxy[1].InstabilityBulgeMass 0x3db64485  # 0.0889978781
f32 galaxy[1].HotGas 0x00000000  # 0
f32 galaxy[1].MetalsHotGas 0x00000000  # 0
f32 galaxy[1].EjectedMass 0x00000000  # 0
f32 galaxy[1].MetalsEjectedMass 0x00000000  # 0
f32 galaxy[1].H1gas 0x3dfbfbd7  # 0.12303894
f32 galaxy[1].H2gas 0x3e886257  # 0.266375273
f32 galaxy[1].OutflowRate 0x00000000  # 0
