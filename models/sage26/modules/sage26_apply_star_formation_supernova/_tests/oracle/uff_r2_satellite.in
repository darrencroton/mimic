# update_from_feedback (S:1146-1251) as a burst calls it, with SFprescription 1: after the
# cold-gas and metal debits the float max_h_fb = 0.74 of the remaining ColdGas caps H2gas and
# H1gas, each on its own, strictly, before the central's hot-gas credit (S:1169-1173).
# A satellite's feedback: the caps act on the reheated galaxy (galaxy 1) only; the FoF central's H2gas and H1gas, above its own hydrogen, are left as they are.
# Constructed input (not R2 output); every value is set explicitly. Flags and parameters are R2's.
# Reachability: R2-reachable.
format sage26-oracle-fixture 1
routine update_from_feedback

i32 params.SFprescription 1  # R2 (R2.par:48): BR06 with radial integration
i32 params.H2RadialIntegrationOn 1  # SAGE26's default, R/src/core_read_parameter_file.c:99; R2.par does not set it
i32 params.H2RadialNBins 25  # default, R/src/core_read_parameter_file.c:100
f64 params.H2RadialRMaxFactor 0x4014000000000000  # 5  (default, R/src/core_read_parameter_file.c:101)
i32 params.StarburstColdGasOn 1  # default, R/src/core_read_parameter_file.c:109; required with SFprescription 1
i32 params.SupernovaRecipeOn 1  # R2.par:50
i32 params.CGMrecipeOn 0  # R2.par:54
i32 call.ngal 2
i32 call.p 1  # the galaxy whose cold gas is reheated
i32 call.centralgal 0  # the FoF central
f64 call.reheated_mass 0x3fb999999999999a  # 0.10000000000000001
f64 call.ejected_mass 0x3f947ae147ae147b  # 0.02

i32 galaxy[0].Type 0
f32 galaxy[0].ColdGas 0x3dcccccd  # 0.100000001
f32 galaxy[0].MetalsColdGas 0x3a83126f  # 0.00100000005
f32 galaxy[0].StellarMass 0x40a00000  # 5
f32 galaxy[0].MetalsStellarMass 0x3da3d70a  # 0.0799999982
f32 galaxy[0].BulgeMass 0x3f800000  # 1
f32 galaxy[0].MetalsBulgeMass 0x3ca3d70a  # 0.0199999996
f32 galaxy[0].InstabilityBulgeMass 0x3f000000  # 0.5
f32 galaxy[0].HotGas 0x41a00000  # 20
f32 galaxy[0].MetalsHotGas 0x3e4ccccd  # 0.200000003
f32 galaxy[0].EjectedMass 0x40400000  # 3
f32 galaxy[0].MetalsEjectedMass 0x3cf5c28f  # 0.0299999993
f32 galaxy[0].H1gas 0x3f000000  # 0.5
f32 galaxy[0].H2gas 0x3f000000  # 0.5
f32 galaxy[0].OutflowRate 0x3d800000  # 0.0625

i32 galaxy[1].Type 1
f32 galaxy[1].ColdGas 0x3f4ccccd  # 0.800000012
f32 galaxy[1].MetalsColdGas 0x3c23d70a  # 0.00999999978
f32 galaxy[1].StellarMass 0x40a00000  # 5
f32 galaxy[1].MetalsStellarMass 0x3da3d70a  # 0.0799999982
f32 galaxy[1].BulgeMass 0x3f800000  # 1
f32 galaxy[1].MetalsBulgeMass 0x3ca3d70a  # 0.0199999996
f32 galaxy[1].InstabilityBulgeMass 0x3f000000  # 0.5
f32 galaxy[1].HotGas 0x00000000  # 0
f32 galaxy[1].MetalsHotGas 0x00000000  # 0
f32 galaxy[1].EjectedMass 0x00000000  # 0
f32 galaxy[1].MetalsEjectedMass 0x00000000  # 0
f32 galaxy[1].H1gas 0x3f19999a  # 0.600000024
f32 galaxy[1].H2gas 0x3f19999a  # 0.600000024
f32 galaxy[1].OutflowRate 0x3d800000  # 0.0625
