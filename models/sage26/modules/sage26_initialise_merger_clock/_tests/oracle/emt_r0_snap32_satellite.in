i32 halo[0].SnapNum 32
i32 halo[1].FirstHaloInFOFgroup 0
i32 halo[1].Len 26
f32 halo[1].Mvir 0x400f1aa0  # 2.23600006
i32 halo[1].SnapNum 32
f64 params.ZZ[32] 0x40008f6a7c393f36  # 2.0700273232431767  (1/AA - 1, R/src/core_init.c:64)

i32 call.ngal 0  # SAGE26's argument ngal: the galaxy's index
