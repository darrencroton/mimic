# A 30-particle subhalo (mass Len * PartMass) in a 12000-particle group: the ordinary clock.
# Reachability: R0-reachable.
format sage26-oracle-fixture 1
routine estimate_merging_time

f64 params.PartMass 0x3fb604189374bc6a  # 0.086  (R0.par:41)
f64 params.MergerTimeFactor 0x4000000000000000  # 2.0  (default, R/src/core_read_parameter_file.c:128)
f64 params.Hubble 0x40590001165723b7  # 100.00006636151998  (HUBBLE * UnitTime_in_s, R/src/core_init.c:106)
f64 params.Omega 0x3fd0000000000000  # 0.25  (R0.par:37)
f64 params.OmegaLambda 0x3fe8000000000000  # 0.75  (R0.par:38)
f64 params.G 0x404580e7ed5ced1b  # 43.00707785642063  (GRAVITY / CUBE(L) * M * SQR(T), R/src/core_init.c:96)

i32 call.nhalos 2
i32 halo[0].FirstHaloInFOFgroup 0
i32 halo[0].Len 12000
f32 halo[0].Mvir 0x44810000  # 1032
i32 halo[0].SnapNum 41
i32 halo[1].FirstHaloInFOFgroup 0
i32 halo[1].Len 30
f32 halo[1].Mvir 0x40251eb8  # 2.57999992
i32 halo[1].SnapNum 41
f64 params.ZZ[41] 0x3fefa37f33930522  # 0.98870811532120606  (1/AA - 1, R/src/core_init.c:64)

i32 call.ngal 0  # SAGE26's argument ngal: the galaxy's index
i32 call.sat_halo 1
i32 call.mother_halo 0

i32 galaxy[0].Type 1
i32 galaxy[0].SnapNum 40
f32 galaxy[0].StellarMass 0x3f666666  # 0.899999976
f32 galaxy[0].ColdGas 0x3eb33333  # 0.349999994
