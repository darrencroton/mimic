# ConcentrationOn 0 (R0-R4, R4.par:57): get_halo_concentration returns 0 at once
# (R/src/model_halo_properties.c:330-332), whatever the galaxy holds; SAGE26's joining
# does not even call it (R/src/core_build_model.c:291), so no float store is made
# (intermediate.store_made 0). The rows are ghc_mode3_selection's.
# Reachability: constructed routine-domain probe.
format sage26-oracle-fixture 1
routine get_halo_concentration
i32 params.ConcentrationOn 0
f64 call.z 0x3ff0000000000000  # 1.0 (passed as SAGE26 passes ZZ[SnapNum]; read by neither mode)
i32 call.ncase 8
# galaxy[0]: Type 0: the current pair (220/180, typical) is selected; the infall pair (100/180, ratio below 1) would give 0
i32 galaxy[0].Type 0
f32 galaxy[0].Vmax 0x435c0000  # 220.0
f32 galaxy[0].Vvir 0x43340000  # 180.0
f32 galaxy[0].infallVmax 0x42c80000  # 100.0
f32 galaxy[0].infallVvir 0x43340000  # 180.0
# galaxy[1]: Type 0: the current pair (100/180, ratio below 1) gives 0; the infall pair (220/180) would not
i32 galaxy[1].Type 0
f32 galaxy[1].Vmax 0x42c80000  # 100.0
f32 galaxy[1].Vvir 0x43340000  # 180.0
f32 galaxy[1].infallVmax 0x435c0000  # 220.0
f32 galaxy[1].infallVvir 0x43340000  # 180.0
# galaxy[2]: Type 1 (a satellite returning to the centre): the infall pair (260/200) is selected; the current pair (150/160) differs
i32 galaxy[2].Type 1
f32 galaxy[2].Vmax 0x43160000  # 150.0
f32 galaxy[2].Vvir 0x43200000  # 160.0
f32 galaxy[2].infallVmax 0x43820000  # 260.0
f32 galaxy[2].infallVvir 0x43480000  # 200.0
# galaxy[3]: Type 1: the infall pair (90/200, ratio below 1) gives 0; the current pair (300/160) would not
i32 galaxy[3].Type 1
f32 galaxy[3].Vmax 0x43960000  # 300.0
f32 galaxy[3].Vvir 0x43200000  # 160.0
f32 galaxy[3].infallVmax 0x42b40000  # 90.0
f32 galaxy[3].infallVvir 0x43480000  # 200.0
# galaxy[4]: Type 1 whose infall was never recorded (the creation value -1, R/src/model_misc.c:190-191): the guard on the infall Vvir returns 0
i32 galaxy[4].Type 1
f32 galaxy[4].Vmax 0x43960000  # 300.0
f32 galaxy[4].Vvir 0x43200000  # 160.0
f32 galaxy[4].infallVmax 0xbf800000  # -1.0
f32 galaxy[4].infallVvir 0xbf800000  # -1.0
# galaxy[5]: Type 0 with current Vvir 0: the guard on the selected pair returns 0
i32 galaxy[5].Type 0
f32 galaxy[5].Vmax 0x43960000  # 300.0
f32 galaxy[5].Vvir 0x00000000  # 0.0
f32 galaxy[5].infallVmax 0x43820000  # 260.0
f32 galaxy[5].infallVvir 0x43480000  # 200.0
# galaxy[6]: Type 2 (routine-domain probe: SAGE26's joining never calls it for a Type 2, R/src/core_build_model.c:240): any Type but 0 takes the infall pair (330/150)
i32 galaxy[6].Type 2
f32 galaxy[6].Vmax 0x43160000  # 150.0
f32 galaxy[6].Vvir 0x43200000  # 160.0
f32 galaxy[6].infallVmax 0x43a50000  # 330.0
f32 galaxy[6].infallVvir 0x43160000  # 150.0
# galaxy[7]: Type 0 at a Vmax/Vvir ratio exactly 1 (float pair 175/175): returns exactly 1.0
i32 galaxy[7].Type 0
f32 galaxy[7].Vmax 0x432f0000  # 175.0
f32 galaxy[7].Vvir 0x432f0000  # 175.0
f32 galaxy[7].infallVmax 0x43820000  # 260.0
f32 galaxy[7].infallVvir 0x43480000  # 200.0
