# update_instability_bulge_radius with BulgeSizeOn 0 (R0): it returns at once
# (R/src/model_misc.c:395), leaving the radii (all 0 on R0) as they were.
# Reachability: R0-reachable.
format sage26-oracle-fixture 1
routine update_instability_bulge_radius

i32 params.BulgeSizeOn 0  # R0 (R0.par:109)

i32 call.ngal 1
i32 call.p 0
f64 call.delta_mass 0x3fb0000000000000  # 0.0625  (the transfer just credited to InstabilityBulgeMass)
f64 call.old_disk_radius 0x3f6e84c180000000  # 0.0037254123017191887  (the disk radius the caller saved)

f32 galaxy[0].MergerBulgeMass 0x00000000  # 0
f32 galaxy[0].InstabilityBulgeMass 0x3e800000  # 0.25
f32 galaxy[0].DiskScaleRadius 0x3b74260c  # 0.0037254123
f32 galaxy[0].BulgeRadius 0x00000000  # 0
f32 galaxy[0].MergerBulgeRadius 0x00000000  # 0
f32 galaxy[0].InstabilityBulgeRadius 0x00000000  # 0
