# Mode 3, a repeated transfer: M_old > 0 and R_old > 0, Tonini et al. 2016 eq. 15 in kpc
# (R/src/model_misc.c:411-416), then get_bulge_radius recombines both channels.
# Reachability: R1-reachable.
format sage26-oracle-fixture 1
routine update_instability_bulge_radius

i32 params.BulgeSizeOn 3  # R1 (R1.par:109)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R1.par:40; read in mode 3, R/src/model_misc.c:249,398)

i32 call.ngal 1
i32 call.p 0
f64 call.delta_mass 0x3f8948b0f8fab5e6  # 0.0123456789  (the transfer just credited to InstabilityBulgeMass)
f64 call.old_disk_radius 0x3f6e84c180000000  # 0.0037254123017191887  (the disk radius the caller saved)

f32 galaxy[0].MergerBulgeMass 0x3e000000  # 0.125
f32 galaxy[0].InstabilityBulgeMass 0x3e86522c  # 0.262345672
f32 galaxy[0].DiskScaleRadius 0x3b74260c  # 0.0037254123
f32 galaxy[0].BulgeRadius 0x3951b717  # 0.000199999995
f32 galaxy[0].MergerBulgeRadius 0x3a51b717  # 0.00079999998
f32 galaxy[0].InstabilityBulgeRadius 0x399115fb  # 0.000276729319
