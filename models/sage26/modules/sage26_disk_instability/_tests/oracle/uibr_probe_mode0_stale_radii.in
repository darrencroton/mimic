# BulgeSizeOn 0 with stale non-zero radii: the update returns at once, so they survive
# (R/src/model_misc.c:395).
# Reachability: constructed routine-domain probe (R0 never holds a non-zero radius).
format sage26-oracle-fixture 1
routine update_instability_bulge_radius

i32 params.BulgeSizeOn 0  # R0 (R0.par:109)

i32 call.ngal 1
