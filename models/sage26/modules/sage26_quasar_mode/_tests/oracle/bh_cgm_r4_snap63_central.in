f64 params.H2RadialRMaxFactor 0x4014000000000000  # 5.0  (default, R/src/core_read_parameter_file.c:101)
i32 params.SupernovaRecipeOn 1  # R4.par:50
i32 params.CGMrecipeOn 1  # R4.par:54
i32 params.FIREmodeOn 1  # R4.par:55
i32 params.BulgeSizeOn 3  # R4.par:109
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.73  (R4.par:40; read by mode 3, R/src/model_misc.c:249,398)
i32 params.SaveFullSFH 0  # R4.par:60
i32 params.AGNrecipeOn 2  # R4.par:49
i32 params.StarburstColdGasOn 1  # default, R/src/core_read_parameter_file.c:109; R4.par does not set it
i32 params.DiskInstabilityOn 1  # R4.par:52
f64 params.FeedbackReheatingEpsilon 0x4007333333333333  # 2.9  (R4.par:69)
