f64 params.EtaSNcode 0x4190547d7abd5eaf  # 68493150.6849315  (EtaSN * (UnitMass_in_g / SOLAR_MASS) / Hubble_h, R/src/core_init.c:103)
f64 params.EnergySNcode 0x3f6e10f01e10f01d  # 0.003670186023127199  (EnergySN / UnitEnergy_in_cgs * Hubble_h, R/src/core_init.c:102)
f64 params.RecycleFraction 0x3fdb851eb851eb85  # 0.43  (R4.par:82)
f64 params.Yield 0x3f9999999999999a  # 0.025  (R4.par:81)
f64 params.FracZleaveDisk 0x0000000000000000  # 0.0  (R4.par:83)
f64 params.ThreshMajorMerger 0x3fd3333333333333  # 0.3  (R4.par:78)
f64 params.BlackHoleGrowthRate 0x3f8eb851eb851eb8  # 0.015  (R4.par:76)
