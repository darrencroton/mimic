# Every substep of one stable central with effective_steps 10: each bin sampled once.
# Constructed input (not R0 output); every value is set explicitly. All flags and parameters are
# R0's unless a line says NOT R0.
format sage26-oracle-fixture 1
routine starformation_and_feedback_sequence

i32 params.SFprescription 0  # R0
i32 params.SupernovaRecipeOn 1  # R0
i32 params.CGMrecipeOn 0  # R0
i32 params.FIREmodeOn 0  # R0
i32 params.EnhancedStarFormationOn 0  # R0
i32 params.BulgeSizeOn 0  # R0
i32 params.KarpovModeOn 0  # R0
i32 params.SaveFullSFH 0  # R0
i32 params.AGNrecipeOn 2  # R0
i32 params.StarburstColdGasOn 1  # R0; default, R/src/core_read_parameter_file.c:109
i32 params.DiskInstabilityOn 1  # R0
f64 params.SfrEfficiency 0x3fa999999999999a  # 0.05  (R/input/millennium.par:66)
f64 params.FeedbackReheatingEpsilon 0x4007333333333333  # 2.9  (R/input/millennium.par:69)
f64 params.FeedbackEjectionEfficiency 0x3fd3333333333333  # 0.3  (R/input/millennium.par:70)
f64 params.EtaSNcode 0x4190547d7abd5eaf  # 68493150.6849315  (EtaSN * (UnitMass_in_g / SOLAR_MASS) / Hubble_h, R/src/core_init.c:103)
f64 params.EnergySNcode 0x3f6e10f01e10f01d  # 0.003670186023127199  (EnergySN / UnitEnergy_in_cgs * Hubble_h, R/src/core_init.c:102)
f64 params.RecycleFraction 0x3fdb851eb851eb85  # 0.43  (R/input/millennium.par:82)
f64 params.Yield 0x3f9999999999999a  # 0.025  (R/input/millennium.par:81)
f64 params.FracZleaveDisk 0x0000000000000000  # 0.0  (R/input/millennium.par:83)
f64 params.ThreshMajorMerger 0x3fd3333333333333  # 0.3  (R/input/millennium.par:78)
f64 params.BlackHoleGrowthRate 0x3f8eb851eb851eb8  # 0.015  (R/input/millennium.par:76)
f64 params.QuasarModeEfficiency 0x3f747ae147ae147b  # 0.005  (R/input/millennium.par:75)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.73  (R/input/millennium.par:40)
f64 params.G 0x404580e7ed5ced1b  # 43.00707785642063  (GRAVITY / CUBE(L) * M * SQR(T), R/src/core_init.c:96)
f64 params.UnitVelocity_in_cm_per_s 0x40f86a0000000000  # 100000.0  (run file)
f64 params.UnitMass_in_g 0x48ec8a6e9c6c5bda  # 1.989e+43  (run file)
f64 params.UnitTime_in_s 0x43fac39601d1945f  # 3.0856799999999996e+19  (L / V, R/src/core_init.c:94)

i32 call.ngal 1
i32 call.p 0  # the forming galaxy
i32 call.centralgal 0  # its FoF central
i32 call.effective_steps 10
f64 call.deltaT 0x3f2807e823466620  # 0.0001833411094025886  (Age[32] - halo_age, R/src/core_build_model.c:479 (c03's r0_snap32 Age values))
f64 call.dt 0x3ef33986829eb81a  # 1.8334110940258862e-05  (deltaT / effective_steps, R/src/core_build_model.c:516)
f64 call.substep[0].time 0x3f80206e3a7f6574  # 0.00787435642262111  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[1].time 0x3f8016d1773e1618  # 0.007856022311680852  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[2].time 0x3f800d34b3fcc6bc  # 0.007837688200740593  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[3].time 0x3f800397f0bb7760  # 0.007819354089800334  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[4].time 0x3f7ff3f65af45008  # 0.007801019978860076  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[5].time 0x3f7fe0bcd471b14f  # 0.007782685867919816  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[6].time 0x3f7fcd834def1297  # 0.007764351756979557  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[7].time 0x3f7fba49c76c73df  # 0.0077460176460392985  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[8].time 0x3f7fa71040e9d527  # 0.00772768353509904  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[9].time 0x3f7f93d6ba67366f  # 0.007709349424158781  (Age - (step + 0.5) * dt, B:480 (plausible))

