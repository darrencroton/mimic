f64 call.substep[4].time 0x3f20d9d98560df8e  # 0.00012856273923644547  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[5].time 0x3f1dbcad097dc6be  # 0.0001134377110909813  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[6].time 0x3f19c5a70839ce61  # 9.831268294551713e-05  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[7].time 0x3f15cea106f5d603  # 8.318765480005295e-05  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[8].time 0x3f11d79b05b1dda6  # 6.806262665458879e-05  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[9].time 0x3f0bc12a08dbca90  # 5.293759850912461e-05  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[10].time 0x3f03d31e0653d9d4  # 3.781257036366043e-05  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[11].time 0x3ef7ca240797d230  # 2.2687542218196254e-05  (Age - (step + 0.5) * dt, B:480 (plausible))
f64 call.substep[12].time 0x3edfb8300a1fc2e0  # 7.5625140727320756e-06  (Age - (step + 0.5) * dt, B:480 (plausible))

i32 galaxy[0].Type 0
