f64 params.EtaSNcode 0x4190547d7abd5eaf  # 68493150.684931502  (EtaSN * (UnitMass_in_g / SOLAR_MASS) / Hubble_h, R/src/core_init.c:103)
f64 params.EnergySNcode 0x3f6e10f01e10f01d  # 0.0036701860231271991  (EnergySN / UnitEnergy_in_cgs * Hubble_h, R/src/core_init.c:102)
f64 params.RecycleFraction 0x3fdb851eb851eb85  # 0.42999999999999999  (R2.par:82)
f64 params.Yield 0x3f9999999999999a  # 0.025000000000000001  (R2.par:81)
f64 params.FracZleaveDisk 0x0000000000000000  # 0  (R2.par:83)
