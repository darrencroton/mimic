f64 params.ZZ[63] 0x0000000000000000  # 0.0  (1/AA[63] - 1, R/src/core_init.c:66, mini-Millennium a_list)

i32 call.ngal 1
i32 call.p 0  # the forming galaxy
i32 call.centralgal 0  # its FoF central
i32 call.effective_steps 10
f64 call.deltaT 0x3f29c5a70839ce61  # 0.00019662536589103426  (Age[63] - halo_age, R/src/core_build_model.c:479 (c03's r0_snap63 Age values))
f64 call.dt 0x3ef49e1f39c7d84e  # 1.9662536589103428e-05  (deltaT / effective_steps, R/src/core_build_model.c:516)
i32 call.step 0  # substep index
f64 call.time 0x3f287bc5149d50dc  # 0.00018679409759648255  (Age - (step + 0.5) * dt, B:480 (plausible))

