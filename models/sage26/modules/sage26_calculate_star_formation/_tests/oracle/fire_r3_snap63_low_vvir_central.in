# starformation_and_feedback with R3's flags (FIREmodeOn 1, SFprescription 1, BulgeSizeOn 3)
# at substep 0 for a real R3 central at Snap_63 with Vvir below 33 km/s: the coupling is
# capped at 2 (X:121) on R3.
# End-of-snapshot output values used as plausible call inputs, not reconstructed call-time
# state (the writer stores these fields verbatim; DiskScaleRadius is the output's DiskRadius;
# MassLoading is the stale value SAGE26 left, which the FIRE path overwrites). Constructed:
# OutflowRate 0 (its value at substep 0 after the first-occupied reset,
# R/src/core_build_model.c:276) and zero histories, as at substep 0; the timing is the c05 R0
# templates' (c03's Age values). Each galaxy's stored SnapNum is the output snapshot, as
# during the next snapshot's evolution, and ZZ[SnapNum] is SAGE26's 1/AA - 1.
# galaxy 0: R3 reference /Volumes/Internal/results/sage26-campaign/workspace/e01-reference/out/R3/model_0.hdf5 (SHA-256 ab278992616f7137b526e5bd3a43045f2e753e29d84997fc69350255c38f570c), Snap_63 row 1709 (GalaxyIndex 962000000000, Type 0)
# Reachability: R3-reachable
format sage26-oracle-fixture 1
routine starformation_and_feedback_fire

i32 params.SFprescription 1  # R3 (R3.par:48): BR06 with radial integration
i32 params.H2RadialIntegrationOn 1  # SAGE26's default, R/src/core_read_parameter_file.c:99; R3.par does not set it
i32 params.H2RadialNBins 25  # default, R/src/core_read_parameter_file.c:100
f64 params.H2RadialRMaxFactor 0x4014000000000000  # 5.0  (default, R/src/core_read_parameter_file.c:101)
i32 params.SupernovaRecipeOn 1  # R3.par:50
i32 params.CGMrecipeOn 0  # R3.par:54
i32 params.FIREmodeOn 1  # R3.par:55
i32 params.EnhancedStarFormationOn 0  # R3.par:58
i32 params.BulgeSizeOn 3  # R3.par:109
i32 params.KarpovModeOn 0  # default, R/src/core_read_parameter_file.c:130; R3.par does not set it
i32 params.SaveFullSFH 0  # R3.par:60
i32 params.AGNrecipeOn 2  # R3.par:49
i32 params.StarburstColdGasOn 1  # default, R/src/core_read_parameter_file.c:109; R3.par does not set it
i32 params.DiskInstabilityOn 1  # R3.par:52
f64 params.SfrEfficiency 0x3fa999999999999a  # 0.05  (R3.par:66)
f64 params.FeedbackReheatingEpsilon 0x4007333333333333  # 2.9  (R3.par:69)
f64 params.FeedbackEjectionEfficiency 0x3fd3333333333333  # 0.3  (R3.par:70)
f64 params.EtaSNcode 0x4190547d7abd5eaf  # 68493150.6849315  (EtaSN * (UnitMass_in_g / SOLAR_MASS) / Hubble_h, R/src/core_init.c:103)
f64 params.EnergySNcode 0x3f6e10f01e10f01d  # 0.003670186023127199  (EnergySN / UnitEnergy_in_cgs * Hubble_h, R/src/core_init.c:102)
f64 params.RecycleFraction 0x3fdb851eb851eb85  # 0.43  (R3.par:82)
f64 params.Yield 0x3f9999999999999a  # 0.025  (R3.par:81)
f64 params.FracZleaveDisk 0x0000000000000000  # 0.0  (R3.par:83)
f64 params.ThreshMajorMerger 0x3fd3333333333333  # 0.3  (R3.par:78)
f64 params.BlackHoleGrowthRate 0x3f8eb851eb851eb8  # 0.015  (R3.par:76)
