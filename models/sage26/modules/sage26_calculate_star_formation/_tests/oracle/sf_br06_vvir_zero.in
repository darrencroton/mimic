# starformation_and_feedback with R2's flags (SFprescription 1: sfr_br06 with radial integration, BulgeSizeOn 3), at substep 0; a stable disk after star formation, so the instability takes no gas branch.
# The galaxy's own Vvir is 0: sfr_br06 writes H2gas 0 and forms no stars, before tdyn
# (S:208-210); the stale H2gas 0.1 is overwritten.
# Constructed input (not R2 output); every value is set explicitly, the bulge radii deliberately stale.
# Reachability: constructed routine-domain probe (an input SAGE26's routine accepts that R2's dynamics do not produce).
format sage26-oracle-fixture 1
routine starformation_and_feedback

i32 params.SFprescription 1  # R2 (R2.par:48): BR06 with radial integration
i32 params.H2RadialIntegrationOn 1  # SAGE26's default, R/src/core_read_parameter_file.c:99; R2.par does not set it
i32 params.H2RadialNBins 25  # default, R/src/core_read_parameter_file.c:100
f64 params.H2RadialRMaxFactor 0x4014000000000000  # 5  (default, R/src/core_read_parameter_file.c:101)
i32 params.SupernovaRecipeOn 1  # R2.par:50
i32 params.CGMrecipeOn 0  # R2.par:54
i32 params.FIREmodeOn 0  # R2.par:55
i32 params.EnhancedStarFormationOn 0  # R2.par:58
i32 params.BulgeSizeOn 3  # R2 (R2.par:109, as R1)
i32 params.KarpovModeOn 0  # default, R/src/core_read_parameter_file.c:130; R2.par does not set it
i32 params.SaveFullSFH 0  # R2.par:60
i32 params.AGNrecipeOn 2  # R2.par:49
i32 params.StarburstColdGasOn 1  # default, R/src/core_read_parameter_file.c:109; R2.par does not set it
i32 params.DiskInstabilityOn 1  # R2.par:52
f64 params.SfrEfficiency 0x3fa999999999999a  # 0.050000000000000003  (R2.par:66)
f64 params.FeedbackReheatingEpsilon 0x4007333333333333  # 2.8999999999999999  (R2.par:69)
f64 params.FeedbackEjectionEfficiency 0x3fd3333333333333  # 0.29999999999999999  (R2.par:70)
f64 params.EtaSNcode 0x4190547d7abd5eaf  # 68493150.684931502  (EtaSN * (UnitMass_in_g / SOLAR_MASS) / Hubble_h, R/src/core_init.c:103)
f64 params.EnergySNcode 0x3f6e10f01e10f01d  # 0.0036701860231271991  (EnergySN / UnitEnergy_in_cgs * Hubble_h, R/src/core_init.c:102)
f64 params.RecycleFraction 0x3fdb851eb851eb85  # 0.42999999999999999  (R2.par:82)
f64 params.Yield 0x3f9999999999999a  # 0.025000000000000001  (R2.par:81)
f64 params.FracZleaveDisk 0x0000000000000000  # 0  (R2.par:83)
f64 params.ThreshMajorMerger 0x3fd3333333333333  # 0.29999999999999999  (R2.par:78)
f64 params.BlackHoleGrowthRate 0x3f8eb851eb851eb8  # 0.014999999999999999  (R2.par:76)
f64 params.QuasarModeEfficiency 0x3f747ae147ae147b  # 0.0050000000000000001  (R2.par:75)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R2.par:40)
f64 params.G 0x404580e7ed5ced1b  # 43.007077856420629  (GRAVITY / CUBE(L) * M * SQR(T), R/src/core_init.c:96)
f64 params.UnitVelocity_in_cm_per_s 0x40f86a0000000000  # 100000  (run file)

i32 call.ngal 1
i32 call.p 0  # the forming galaxy
i32 call.centralgal 0  # its FoF central
i32 call.effective_steps 10
f64 call.deltaT 0x3f2807e823466620  # 0.00018334110940258861  (Age[32] - halo_age, R/src/core_build_model.c:479 (c03's r0_snap32 Age values))
f64 call.dt 0x3ef33986829eb81a  # 1.8334110940258862e-05  (deltaT / effective_steps, R/src/core_build_model.c:516)
i32 call.step 0  # substep index; step bin 0
f64 call.time 0x3f80206e3a7f6574  # 0.0078743564226211107  (Age - (step + 0.5) * dt, B:480 (plausible))

i32 galaxy[0].Type 0
f32 galaxy[0].Mvir 0x42480000  # 50
f32 galaxy[0].Vvir 0x00000000  # 0
