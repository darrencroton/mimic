# calculate_molecular_fraction_radial_integration called directly as sfr_br06 calls it (R/src/model_starformation_and_feedback.c:222): SFprescription 1, a NULL SFR-output pointer.
# BulgeMass above StellarMass: the float difference is negative, sigma_star_0 is 0
# (H:151, M_disk_star > 0.0 false) and every annulus takes the floor (H:74-76).
# Constructed input (not R2 output); every value is set explicitly.
# Reachability: constructed routine-domain probe (an input SAGE26's routine accepts that R2's dynamics do not produce).
format sage26-oracle-fixture 1
routine calculate_molecular_fraction_radial_integration

i32 params.SFprescription 1  # R2 (R2.par:48): BR06 with radial integration
i32 params.H2RadialIntegrationOn 1  # SAGE26's default, R/src/core_read_parameter_file.c:99; R2.par does not set it
i32 params.H2RadialNBins 25  # default, R/src/core_read_parameter_file.c:100
f64 params.H2RadialRMaxFactor 0x4014000000000000  # 5  (default, R/src/core_read_parameter_file.c:101)
i32 params.StarburstColdGasOn 1  # default, R/src/core_read_parameter_file.c:109; required with SFprescription 1
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R2.par:40)

f32 galaxy[0].DiskScaleRadius 0x3ac49ba6  # 0.00150000001
f32 galaxy[0].ColdGas 0x3f000000  # 0.5
f32 galaxy[0].MetalsColdGas 0x3bf5c28f  # 0.00749999983
f32 galaxy[0].StellarMass 0x3e99999a  # 0.300000012
f32 galaxy[0].BulgeMass 0x3e9eb852  # 0.310000002
f32 galaxy[0].H2gas 0x3d23d70a  # 0.0399999991
f32 galaxy[0].H2DepletionTime_Gyr 0xbf800000  # -1
