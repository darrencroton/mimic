# calculate_ffb_fraction across the sigmoid: widened float Mvir from 0.45 dex below to 0.45 dex
# above the threshold (x about -3 to 3), at the redshifts of snapshots 8, 12, 16, 20 and 27 (the
# snapshots where the R6 reference holds FFB rows)
# ZZ = 1 / a - 1 of simulations/mini-millennium/mini-millennium.a_list (SAGE26's
# R/src/core_init.c:66, Mimic's src/core/init.c:60), equal bit for bit to the R6 reference's
# Header/snapshot_redshifts
# Reachability: R6-reachable (widened float Mvir at R6 Zcurr values)
format sage26-oracle-fixture 1
routine calculate_ffb_fraction
i32 params.EnhancedStarFormationOn 1  # R6.par:58
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.73
i32 call.ncase 25
f64 case[0].Mvir 0x3fc0585b40000000  # float(threshold * 10^(-0.450)) at ZZ[8]
