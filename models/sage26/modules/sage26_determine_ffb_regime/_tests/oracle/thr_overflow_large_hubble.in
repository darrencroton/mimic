# calculate_ffb_threshold_mass with Hubble_h 1e302, constructed so that a finite exponent
# overflows: z 0 (about 309) and -0.5 (about 311) give +inf; z 9 (about 302.8) and 1 (about 307.1)
# stay finite. At Hubble_h 0.73 only z = -1 gives +inf (thr_constructed_redshifts)
# Reachability: constructed routine-domain probe
format sage26-oracle-fixture 1
routine calculate_ffb_threshold_mass
f64 params.Hubble_h 0x7ea2aa4f4a405be2  # 1e+302
i32 call.ncase 4
f64 case[0].z 0x0000000000000000  # 0.0
f64 case[1].z 0xbfe0000000000000  # -0.5
f64 case[2].z 0x4022000000000000  # 9.0
f64 case[3].z 0x3ff0000000000000  # 1.0
