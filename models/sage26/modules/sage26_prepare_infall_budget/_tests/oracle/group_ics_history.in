f32 galaxy[1].MetalsEjectedMass 0x3a378034  # 0.000699999975
f32 galaxy[1].ICS 0x3c23d70a  # 0.00999999978
f32 galaxy[1].MetalsICS 0x3951b717  # 0.000199999995
f32 galaxy[1].CGMgas 0x00000000  # 0
f32 galaxy[1].MetalsCGMgas 0x00000000  # 0
f32 galaxy[1].ICS_disrupt 0x3b83126f  # 0.00400000019
f32 galaxy[1].ICS_accrete 0x3bc49ba6  # 0.00600000005
