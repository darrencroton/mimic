f32 galaxy[0].EjectedMass 0x3f19999a  # 0.600000024
f32 galaxy[0].MetalsEjectedMass 0x3bc49ba6  # 0.00600000005
f32 galaxy[0].ICS 0x3d4ccccd  # 0.0500000007
f32 galaxy[0].MetalsICS 0x3a83126f  # 0.00100000005
f32 galaxy[0].CGMgas 0x00000000  # 0
f32 galaxy[0].MetalsCGMgas 0x00000000  # 0
f32 galaxy[0].ICS_disrupt 0x3cf5c28f  # 0.0299999993
f32 galaxy[0].ICS_accrete 0x3ca3d70a  # 0.0199999996
f32 galaxy[0].ICS_sum_mt 0x3ecccccd  # 0.400000006

i32 galaxy[1].Type 1
f32 galaxy[1].Mvir 0x40c00000  # 6
