# Tiny negative ICS metals: the floor at R/src/model_infall.c:208 resets the central's MetalsICS
# to 0; the satellite has ICS == 0, so its history is not consolidated.
format sage26-oracle-fixture 1
routine infall_recipe

i32 params.ReionizationOn 1
i32 params.CGMrecipeOn 0
f64 params.BaryonFrac 0x3fc5c28f5c28f5c3  # 0.17000000000000001
f64 params.a0 0x3fbc71c71c71c71c  # 0.1111111111111111  (1/(1+Reionization_z0), z0 = 8)
f64 params.ar 0x3fc0000000000000  # 0.125  (1/(1+Reionization_zr), zr = 7)
f64 params.Omega 0x3fd0000000000000  # 0.25
f64 params.OmegaLambda 0x3fe8000000000000  # 0.75
f64 params.Hubble 0x40590001165723b7  # 100.00006636151998  (HUBBLE * UnitTime_in_s)
f64 params.G 0x404580e7ed5ced1b  # 43.007077856420629  (GRAVITY / CUBE(L) * M * SQR(T))

i32 call.ngal 2
i32 call.centralgal 0
f64 call.Zcurr 0x0000000000000000  # 0

i32 galaxy[0].Type 0
f32 galaxy[0].Mvir 0x42480000  # 50
f32 galaxy[0].StellarMass 0x3f000000  # 0.5
f32 galaxy[0].BlackHoleMass 0x3a83126f  # 0.00100000005
f32 galaxy[0].ColdGas 0x3ecccccd  # 0.400000006
f32 galaxy[0].HotGas 0x40400000  # 3
f32 galaxy[0].MetalsHotGas 0x3cf5c28f  # 0.0299999993
f32 galaxy[0].EjectedMass 0x3f19999a  # 0.600000024
f32 galaxy[0].MetalsEjectedMass 0x3bc49ba6  # 0.00600000005
f32 galaxy[0].ICS 0x00000000  # 0
f32 galaxy[0].MetalsICS 0xac0cbccc  # -1.99999999e-12
f32 galaxy[0].CGMgas 0x00000000  # 0
f32 galaxy[0].MetalsCGMgas 0x00000000  # 0
f32 galaxy[0].ICS_disrupt 0x00000000  # 0
f32 galaxy[0].ICS_accrete 0x00000000  # 0
f32 galaxy[0].ICS_sum_mt 0x00000000  # 0

i32 galaxy[1].Type 1
f32 galaxy[1].Mvir 0x40c00000  # 6
f32 galaxy[1].StellarMass 0x3e4ccccd  # 0.200000003
f32 galaxy[1].BlackHoleMass 0x39d1b717  # 0.00039999999
f32 galaxy[1].ColdGas 0x3dcccccd  # 0.100000001
f32 galaxy[1].HotGas 0x3e99999a  # 0.300000012
f32 galaxy[1].MetalsHotGas 0x3b83126f  # 0.00400000019
f32 galaxy[1].EjectedMass 0x3d4ccccd  # 0.0500000007
f32 galaxy[1].MetalsEjectedMass 0x3a378034  # 0.000699999975
f32 galaxy[1].ICS 0x00000000  # 0
f32 galaxy[1].MetalsICS 0x00000000  # 0
f32 galaxy[1].CGMgas 0x00000000  # 0
f32 galaxy[1].MetalsCGMgas 0x00000000  # 0
f32 galaxy[1].ICS_disrupt 0x00000000  # 0
f32 galaxy[1].ICS_accrete 0x00000000  # 0
f32 galaxy[1].ICS_sum_mt 0x00000000  # 0
