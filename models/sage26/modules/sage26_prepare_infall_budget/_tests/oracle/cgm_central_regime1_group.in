f32 galaxy[0].MetalsICS 0x3b03126f  # 0.00200000009
f32 galaxy[0].CGMgas 0x40500000  # 3.25
f32 galaxy[0].MetalsCGMgas 0x3d23d70a  # 0.0399999991
f32 galaxy[0].ICS_disrupt 0x3dcccccd  # 0.100000001
f32 galaxy[0].ICS_accrete 0x3dcccccd  # 0.100000001
f32 galaxy[0].ICS_sum_mt 0x3d4ccccd  # 0.0500000007
# galaxy[1]: Type 1, Regime 1, holds both pairs

i32 galaxy[1].Type 1
i32 galaxy[1].Regime 1
f32 galaxy[1].Mvir 0x41200000  # 10
