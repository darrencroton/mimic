f32 galaxy[1].ICS 0x3c23d70a  # 0.00999999978
f32 galaxy[1].MetalsICS 0x38d1b717  # 9.99999975e-05
f32 galaxy[1].CGMgas 0x3f19999a  # 0.600000024
f32 galaxy[1].MetalsCGMgas 0x3c1374bc  # 0.00899999961
