# TRANSCRIPTION of B:297-298, mode 3: the stale DiskScaleRadius 0.001 is replaced by the new
# disk radius BEFORE get_bulge_radius, whose instability fallback (InstabilityBulgeRadius 0)
# reads it (R/src/model_misc.c:353-355): synchronising before the store would use 0.001.
# Reachability: R1-reachable (a central whose instability mass has no radius yet).
format sage26-oracle-fixture 1
routine central_disk_and_bulge_radius

i32 params.BulgeSizeOn 3  # R1 (R1.par:109)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R1.par:40; read in mode 3, R/src/model_misc.c:249,398)

i32 call.ngal 1
i32 call.p 0

i32 galaxy[0].Type 0
f32 galaxy[0].Vvir 0x43480000  # 200
f32 galaxy[0].Rvir 0x3e4ccccd  # 0.200000003

f32 halo.Spin[0] 0x41480000  # 12.5
f32 halo.Spin[1] 0xc0e80000  # -7.25
f32 halo.Spin[2] 0x41f00000  # 30

f32 galaxy[0].MergerBulgeMass 0x3e800000  # 0.25
f32 galaxy[0].InstabilityBulgeMass 0x3e000000  # 0.125
f32 galaxy[0].DiskScaleRadius 0x3a83126f  # 0.00100000005
f32 galaxy[0].BulgeRadius 0x3a03126f  # 0.000500000024
f32 galaxy[0].MergerBulgeRadius 0x3a378034  # 0.000699999975
f32 galaxy[0].InstabilityBulgeRadius 0x00000000  # 0
