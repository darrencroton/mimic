# Mode 3, both channels positive with zero radii and a positive disk radius: the merger Shen
# fallback and the instability disk fallback. The average uses both DOUBLE fallback radii
# (R/src/model_misc.c:346, :355, :366), not the narrowed floats stored at :347, :362; reloading
# the floats changes the double return (an executed mutant, validation record).
# Reachability: R1-reachable (a bulgeless target absorbing both of a satellite's channels).
format sage26-oracle-fixture 1
routine get_bulge_radius

i32 params.BulgeSizeOn 3  # R1 (R1.par:109)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R1.par:40; read in mode 3, R/src/model_misc.c:249,398)

i32 call.ngal 1
i32 call.p 0

f32 galaxy[0].MergerBulgeMass 0x3ec00000  # 0.375
f32 galaxy[0].InstabilityBulgeMass 0x3e800000  # 0.25
f32 galaxy[0].DiskScaleRadius 0x3b871e10  # 0.00412345678
f32 galaxy[0].BulgeRadius 0x00000000  # 0
f32 galaxy[0].MergerBulgeRadius 0x00000000  # 0
f32 galaxy[0].InstabilityBulgeRadius 0x00000000  # 0
