# get_bulge_radius with BulgeSizeOn 0 (R0): the three radii are zeroed and 0 returned
# (R/src/model_misc.c:242-247), whatever the channel masses. Every R0 radius is already 0.
# Reachability: R0-reachable.
format sage26-oracle-fixture 1
routine get_bulge_radius

i32 params.BulgeSizeOn 0  # R0 (R0.par:109)

