# Mode 3, a negative merger mass outweighing a positive instability mass: M_total < 0 zeroes
# the radii (R/src/model_misc.c:322-327), the stale radii included.
# Reachability: constructed routine-domain probe (negative channel masses).
format sage26-oracle-fixture 1
routine get_bulge_radius

i32 params.BulgeSizeOn 3  # R1 (R1.par:109)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R1.par:40; read in mode 3, R/src/model_misc.c:249,398)

i32 call.ngal 1
i32 call.p 0

f32 galaxy[0].MergerBulgeMass 0xba83126f  # -0.00100000005
f32 galaxy[0].InstabilityBulgeMass 0x3a03126f  # 0.000500000024
f32 galaxy[0].DiskScaleRadius 0x3b83126f  # 0.00400000019
f32 galaxy[0].BulgeRadius 0x3a03126f  # 0.000500000024
f32 galaxy[0].MergerBulgeRadius 0x3a378034  # 0.000699999975
f32 galaxy[0].InstabilityBulgeRadius 0x399d4952  # 0.000300000014
