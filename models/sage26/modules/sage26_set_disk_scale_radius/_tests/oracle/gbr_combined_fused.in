# Mode 3, the merger Shen fallback beside a positive instability radius: the :366 numerator
# fuses M_merger * R_merger (a double fallback radius, so the product is inexact) onto the
# rounded instability product. Separates the fused :366: with :345 fused as in SAGE26, a fused
# and an unfused :366 give different double returns (MergerBulgeMass 0x3ec00043 found by a
# scratch search, validation record).
# Reachability: R1-reachable.
format sage26-oracle-fixture 1
routine get_bulge_radius

i32 params.BulgeSizeOn 3  # R1 (R1.par:109)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R1.par:40; read in mode 3, R/src/model_misc.c:249,398)

i32 call.ngal 1
i32 call.p 0

f32 galaxy[0].MergerBulgeMass 0x3ec00043  # 0.375001997
f32 galaxy[0].InstabilityBulgeMass 0x3e800000  # 0.25
f32 galaxy[0].DiskScaleRadius 0x3b83126f  # 0.00400000019
f32 galaxy[0].BulgeRadius 0x38d1b717  # 9.99999975e-05
f32 galaxy[0].MergerBulgeRadius 0x00000000  # 0
f32 galaxy[0].InstabilityBulgeRadius 0x399d4952  # 0.000300000014
