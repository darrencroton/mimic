# Mode 3, a pure instability bulge with InstabilityBulgeRadius 0 and DiskScaleRadius 0: the
# instability Shen fallback's M_inst * 1e10 / h, left to right (R/src/model_misc.c:358); for
# InstabilityBulgeMass 0x3c003e42 the regrouping M * (1e10 / h) changes the double return
# (validation record).
# Reachability: constructed routine-domain probe (a zero disk radius beside instability mass).
format sage26-oracle-fixture 1
routine get_bulge_radius

i32 params.BulgeSizeOn 3  # R1 (R1.par:109)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R1.par:40; read in mode 3, R/src/model_misc.c:249,398)

i32 call.ngal 1
i32 call.p 0

f32 galaxy[0].MergerBulgeMass 0x00000000  # 0
f32 galaxy[0].InstabilityBulgeMass 0x3c003e42  # 0.00782734342
f32 galaxy[0].DiskScaleRadius 0x00000000  # 0
f32 galaxy[0].BulgeRadius 0x00000000  # 0
f32 galaxy[0].MergerBulgeRadius 0x00000000  # 0
f32 galaxy[0].InstabilityBulgeRadius 0x00000000  # 0
