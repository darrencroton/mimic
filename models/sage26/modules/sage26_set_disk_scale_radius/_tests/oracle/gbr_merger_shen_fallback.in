# Mode 3, a pure merger bulge (InstabilityBulgeMass exactly 0) with MergerBulgeRadius 0: the
# Shen et al. 2003 fallback (R/src/model_misc.c:343-348). Separates the fused :345: fused
# and unfused 0.56 * log10(M_sun) - 5.54 give different double radii, which reach the double
# return (the :366 numerator has a zero instability product, so it cannot separate here).
# MergerBulgeMass 0.0078125 was found by a scratch search (validation record).
# Reachability: R1-reachable (a merger bulge whose remnant radius came back 0, :341).
format sage26-oracle-fixture 1
routine get_bulge_radius

i32 params.BulgeSizeOn 3  # R1 (R1.par:109)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R1.par:40; read in mode 3, R/src/model_misc.c:249,398)

i32 call.ngal 1
i32 call.p 0

f32 galaxy[0].MergerBulgeMass 0x3c000000  # 0.0078125
f32 galaxy[0].InstabilityBulgeMass 0x00000000  # 0
f32 galaxy[0].DiskScaleRadius 0x3b83126f  # 0.00400000019
f32 galaxy[0].BulgeRadius 0x00000000  # 0
f32 galaxy[0].MergerBulgeRadius 0x00000000  # 0
f32 galaxy[0].InstabilityBulgeRadius 0x00000000  # 0
