# Positive Vvir and Rvir below the package's 1e-10 guard: SAGE26 evaluates the formula.
format sage26-oracle-fixture 1
routine get_disk_radius

i32 galaxy[0].Type 0
f32 galaxy[0].Vvir 0x2d2febff  # 9.99999996e-12
f32 galaxy[0].Rvir 0x2d2febff  # 9.99999996e-12
f32 halo.Spin[0] 0x1e3ce508  # 9.99999968e-21
f32 halo.Spin[1] 0x1ebce508  # 1.99999994e-20
f32 halo.Spin[2] 0x9f0dabc6  # -2.9999999e-20
