# Mode 3, a positive instability mass with InstabilityBulgeRadius 0 and a positive disk radius:
# 0.2 * DiskScaleRadius (R/src/model_misc.c:351-356), a double kept for the average while its
# float is stored.
# Reachability: R1-reachable (instability mass arriving without a radius, e.g. a satellite's
# channel added by add_galaxies_together, R/src/model_mergers.c:504).
format sage26-oracle-fixture 1
routine get_bulge_radius

i32 params.BulgeSizeOn 3  # R1 (R1.par:109)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R1.par:40; read in mode 3, R/src/model_misc.c:249,398)

i32 call.ngal 1
i32 call.p 0

f32 galaxy[0].MergerBulgeMass 0x3ec00000  # 0.375
f32 galaxy[0].InstabilityBulgeMass 0x3e800000  # 0.25
f32 galaxy[0].DiskScaleRadius 0x3b871e10  # 0.00412345678
f32 galaxy[0].BulgeRadius 0x38d1b717  # 9.99999975e-05
f32 galaxy[0].MergerBulgeRadius 0x3a51b717  # 0.00079999998
f32 galaxy[0].InstabilityBulgeRadius 0x00000000  # 0
