# Mode 3, MergerBulgeMass -0.0 with a stale radius: -0.0 == 0.0, so the radius is zeroed
# (R/src/model_misc.c:332-334) and the merger term of the average is -0.0 * 0.0.
# Reachability: constructed routine-domain probe (signed zero).
format sage26-oracle-fixture 1
routine get_bulge_radius

i32 params.BulgeSizeOn 3  # R1 (R1.par:109)
