i32 call.p 0

f32 galaxy[0].MergerBulgeMass 0x80000000  # -0
f32 galaxy[0].InstabilityBulgeMass 0x3e800000  # 0.25
f32 galaxy[0].DiskScaleRadius 0x3b83126f  # 0.00400000019
