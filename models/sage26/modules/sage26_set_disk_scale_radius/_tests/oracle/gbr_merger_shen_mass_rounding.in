# Mode 3, a pure merger bulge with MergerBulgeRadius 0: the Shen fallback's solar mass is
# CODE_MASS_TO_MSUN(M, h) = M * 1e10 / h, left to right (R/src/model_misc.c:344,
# R/src/macros.h:45). For MergerBulgeMass 0x3c003e42 the regrouping M * (1e10 / h) changes the
# double return (scratch search and the executed mutation sweep, validation record).
# Reachability: R1-reachable (a merger bulge whose remnant radius came back 0).
format sage26-oracle-fixture 1
routine get_bulge_radius

i32 params.BulgeSizeOn 3  # R1 (R1.par:109)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R1.par:40; read in mode 3, R/src/model_misc.c:249,398)

i32 call.ngal 1
i32 call.p 0

f32 galaxy[0].MergerBulgeMass 0x3c003e42  # 0.00782734342
f32 galaxy[0].InstabilityBulgeMass 0x00000000  # 0
f32 galaxy[0].DiskScaleRadius 0x3b83126f  # 0.00400000019
f32 galaxy[0].BulgeRadius 0x00000000  # 0
f32 galaxy[0].MergerBulgeRadius 0x00000000  # 0
f32 galaxy[0].InstabilityBulgeRadius 0x00000000  # 0
