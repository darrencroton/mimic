# writer_mdot_conversion: SAGE26's writer conversion of the mdot rates
# (R/src/io/save_gals_hdf5.c:996-997), a transcription compiled in the oracle.
# UnitMass_in_g 1.989e43 * (1 + 155e-6) and raw rates for which the writer and the
# same terms with the division by UnitTime_in_s first round to different floats (an
# exhaustive scratch search; the slice's validation record).
# Reachability: constructed routine-domain probe.
format sage26-oracle-fixture 1
routine writer_mdot_conversion

f64 params.UnitMass_in_g 0x48ec8b9087beab5a  # 1.989308295e+43
f64 params.UnitTime_in_s 0x43fac39601d1945f  # 3.0856799999999996e+19
f32 galaxy[0].mdot_cool 0x3f80c3de  # 1.0059773921966553  raw float
f32 galaxy[0].mdot_stream 0x3f9b029e  # 1.211017370223999  raw float
