# Three galaxies of one R0 FoF group: Cooling, Heating and OutflowRate are the outputs converted
# back to code units times deltaT (plausible accumulators).
# galaxy 0: R0 reference model_0.hdf5 (SHA-256 6d859a3a2ea422e3...) Snap_63 row 0, GalaxyIndex 0,
# Type 0
# galaxy 1: R0 reference model_0.hdf5 (SHA-256 6d859a3a2ea422e3...) Snap_63 row 1, GalaxyIndex
# 290, Type 1
# galaxy 2: R0 reference model_0.hdf5 (SHA-256 6d859a3a2ea422e3...) Snap_63 row 2, GalaxyIndex
# 256, Type 1
# Age values as c03's r0 fixtures.
format sage26-oracle-fixture 1
routine normalise_outflow_rate

f64 params.UnitMass_in_g 0x48ec8a6e9c6c5bda  # 1.989e+43  (run file)
f64 params.UnitTime_in_s 0x43fac39601d1945f  # 3.0856799999999996e+19  (L / V, R/src/core_init.c:94)
i32 call.ngal 3
f64 call.halo_age 0x0000000000000000  # 0.0  (Age[halo_snapnum])
i32 galaxy[0].Type 0
i32 galaxy[0].SnapNum 63
f64 call.Age[63] 0x3f29c5a70839ce61  # 0.00019662536589103426
i32 galaxy[0].mergeType 0
f64 galaxy[0].Cooling 0x40a00ae731ee34de  # 2053.4515528144393
f64 galaxy[0].Heating 0x40a00ae731ee34de  # 2053.4515528144393
f32 galaxy[0].OutflowRate 0x00000000  # 0
i32 galaxy[1].Type 1
i32 galaxy[1].SnapNum 63
i32 galaxy[1].mergeType 0
f64 galaxy[1].Cooling 0x0000000000000000  # 0.0
f64 galaxy[1].Heating 0x0000000000000000  # 0.0
f32 galaxy[1].OutflowRate 0x00000000  # 0
i32 galaxy[2].Type 1
i32 galaxy[2].SnapNum 63
i32 galaxy[2].mergeType 0
f64 galaxy[2].Cooling 0x0000000000000000  # 0.0
f64 galaxy[2].Heating 0x0000000000000000  # 0.0
f32 galaxy[2].OutflowRate 0x3b5d6d7f  # 0.00337871886
