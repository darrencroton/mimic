# writer_mdot_conversion: SAGE26's writer conversion of the mdot rates
# (R/src/io/save_gals_hdf5.c:996-997), a transcription compiled in the oracle.
# The smallest subnormal and the smallest normal float raw rates, the run units.
# Reachability: constructed routine-domain probe.
format sage26-oracle-fixture 1
routine writer_mdot_conversion

f64 params.UnitMass_in_g 0x48ec8a6e9c6c5bda  # 1.989e+43
f64 params.UnitTime_in_s 0x43fac39601d1945f  # 3.0856799999999996e+19
f32 galaxy[0].mdot_cool 0x00000001  # 1.401298464324817e-45  raw float
f32 galaxy[0].mdot_stream 0x00800000  # 1.1754943508222875e-38  raw float
