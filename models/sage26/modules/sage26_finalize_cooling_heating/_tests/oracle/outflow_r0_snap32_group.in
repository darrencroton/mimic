# Three galaxies of one R0 FoF group: Cooling, Heating and OutflowRate are the outputs converted
# back to code units times deltaT (plausible accumulators).
# galaxy 0: R0 reference model_0.hdf5 (SHA-256 6d859a3a2ea422e3...) Snap_32 row 0, GalaxyIndex 0,
# Type 0
# galaxy 1: R0 reference model_0.hdf5 (SHA-256 6d859a3a2ea422e3...) Snap_32 row 1, GalaxyIndex 28,
# Type 1
# galaxy 2: R0 reference model_0.hdf5 (SHA-256 6d859a3a2ea422e3...) Snap_32 row 2, GalaxyIndex 27,
# Type 1
# Age values as c03's r0 fixtures.
format sage26-oracle-fixture 1
routine normalise_outflow_rate

f64 params.UnitMass_in_g 0x48ec8a6e9c6c5bda  # 1.989e+43  (run file)
f64 params.UnitTime_in_s 0x43fac39601d1945f  # 3.0856799999999996e+19  (L / V, R/src/core_init.c:94)
i32 call.ngal 3
f64 call.halo_age 0x3f7f8a39f725e713  # 0.0077001823686886515  (Age[halo_snapnum])
i32 galaxy[0].Type 0
i32 galaxy[0].SnapNum 32
f64 call.Age[32] 0x3f80253c9c200d22  # 0.00788352347809124
i32 galaxy[0].mergeType 0
f64 galaxy[0].Cooling 0x40b1d10eaa05ccf7  # 4561.057281839886
f64 galaxy[0].Heating 0x40b1d10eaa05ccf7  # 4561.057281839886
f32 galaxy[0].OutflowRate 0x00000000  # 0
i32 galaxy[1].Type 1
i32 galaxy[1].SnapNum 32
i32 galaxy[1].mergeType 0
f64 galaxy[1].Cooling 0x40b691ada9d849d0  # 5777.678372877141
f64 galaxy[1].Heating 0x40710f382a3489bd  # 272.95121212504074
f32 galaxy[1].OutflowRate 0x3f03c50f  # 0.514725626
i32 galaxy[2].Type 1
i32 galaxy[2].SnapNum 32
i32 galaxy[2].mergeType 0
f64 galaxy[2].Cooling 0x40585670a9cbdf39  # 97.35062642011043
f64 galaxy[2].Heating 0x0000000000000000  # 0.0
f32 galaxy[2].OutflowRate 0x3d2b1e50  # 0.0417769551
