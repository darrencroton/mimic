# Real Type 1 satellite with hot gas and its central.
# galaxy[0]: R0 reference model_0.hdf5 (SHA-256 6d859a3a2ea422e3...), Snap_32 row 0, GalaxyIndex 0: end-of-snapshot output values used as plausible call inputs, not reconstructed call-time state
# galaxy[1]: R0 reference model_0.hdf5 (SHA-256 6d859a3a2ea422e3...), Snap_32 row 1, GalaxyIndex 28: end-of-snapshot output values used as plausible call inputs, not reconstructed call-time state
# Zcurr = ZZ[32]; effective_steps from the central's Rvir/Vvir (R/src/core_build_model.c:430-459).
format sage26-oracle-fixture 1
routine strip_from_satellite

i32 params.ReionizationOn 1
i32 params.CGMrecipeOn 0
f64 params.BaryonFrac 0x3fc5c28f5c28f5c3  # 0.17000000000000001
