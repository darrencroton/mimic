# Real Type 1 satellite with hot gas and its central.
# galaxy[0]: R0 reference model_0.hdf5 (SHA-256 6d859a3a2ea422e3...), Snap_63 row 0, GalaxyIndex 0: end-of-snapshot output values used as plausible call inputs, not reconstructed call-time state
# galaxy[1]: R0 reference model_0.hdf5 (SHA-256 6d859a3a2ea422e3...), Snap_63 row 1, GalaxyIndex 290: end-of-snapshot output values used as plausible call inputs, not reconstructed call-time state
# Zcurr = ZZ[63]; effective_steps from the central's Rvir/Vvir (R/src/core_build_model.c:430-459).
format sage26-oracle-fixture 1
routine strip_from_satellite

i32 params.ReionizationOn 1
i32 params.CGMrecipeOn 0
f64 params.BaryonFrac 0x3fc5c28f5c28f5c3  # 0.17000000000000001
f64 params.a0 0x3fbc71c71c71c71c  # 0.1111111111111111  (1/(1+Reionization_z0), z0 = 8)
f64 params.ar 0x3fc0000000000000  # 0.125  (1/(1+Reionization_zr), zr = 7)
f64 params.Omega 0x3fd0000000000000  # 0.25
f64 params.OmegaLambda 0x3fe8000000000000  # 0.75
f64 params.Hubble 0x40590001165723b7  # 100.00006636151998  (HUBBLE * UnitTime_in_s)
f64 params.G 0x404580e7ed5ced1b  # 43.007077856420629  (GRAVITY / CUBE(L) * M * SQR(T))

i32 call.ngal 2
i32 call.centralgal 0
i32 call.satellite 1
f64 call.Zcurr 0x0000000000000000  # 0
i32 call.effective_steps 10

i32 galaxy[0].Type 0
f32 galaxy[0].Mvir 0x45610fce  # 3600.98779
f32 galaxy[0].StellarMass 0x4092215a  # 4.56657124
f32 galaxy[0].ColdGas 0x3efde76f  # 0.495906323
f32 galaxy[0].HotGas 0x43ff7e6f  # 510.987762
f32 galaxy[0].MetalsHotGas 0x3f0922af  # 0.53568548
f32 galaxy[0].CGMgas 0x00000000  # 0
f32 galaxy[0].MetalsCGMgas 0x00000000  # 0
f32 galaxy[0].EjectedMass 0x3e61c5b9  # 0.220480815
f32 galaxy[0].BlackHoleMass 0x3d4d900c  # 0.0501862019
f32 galaxy[0].ICS 0x4223e20a  # 40.9707413

i32 galaxy[1].Type 1
f32 galaxy[1].Mvir 0x435a028f  # 218.009995
f32 galaxy[1].StellarMass 0x4075cd28  # 3.84064674
f32 galaxy[1].ColdGas 0x3ecf7b7d  # 0.405239016
f32 galaxy[1].HotGas 0x41ec8a46  # 29.5675163
f32 galaxy[1].MetalsHotGas 0x3d885dd5  # 0.0665852204
f32 galaxy[1].CGMgas 0x00000000  # 0
