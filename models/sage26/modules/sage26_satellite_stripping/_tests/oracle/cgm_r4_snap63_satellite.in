# /Volumes/Internal/results/sage26-campaign/workspace/e01-reference/out/R4/model_0.hdf5 (SHA-256
# 2b606ee7ac82559e32c7c91161f1edb44f89288ec57016e80da884e118ed0807), Snap_63: end-of-snapshot output
# values used as plausible call inputs, not reconstructed call-time state. Zcurr = ZZ[63] from the
# file header.
# Reachability: R4-reachable.
# R4's flags: CGMrecipeOn 1 (par/R4.par:54); ReionizationOn 1, BaryonFrac 0.17,
# ReIncorporationFactor 0.19 and Reionization_z0/zr 8/7 as R3 (R4.par:51, :39, :72, :85-86).
format sage26-oracle-fixture 1
routine strip_from_satellite

i32 params.ReionizationOn 1
i32 params.CGMrecipeOn 1
f64 params.BaryonFrac 0x3fc5c28f5c28f5c3  # 0.17000000000000001
f64 params.a0 0x3fbc71c71c71c71c  # 0.1111111111111111  (1/(1+Reionization_z0), z0 = 8)
f64 params.ar 0x3fc0000000000000  # 0.125  (1/(1+Reionization_zr), zr = 7)
f64 params.Omega 0x3fd0000000000000  # 0.25
f64 params.OmegaLambda 0x3fe8000000000000  # 0.75
f64 params.Hubble 0x40590001165723b7  # 100.00006636151998  (HUBBLE * UnitTime_in_s)
f64 params.G 0x404580e7ed5ced1b  # 43.007077856420629  (GRAVITY / CUBE(L) * M * SQR(T))

i32 call.ngal 2
i32 call.centralgal 0
i32 call.satellite 1
f64 call.Zcurr 0x0000000000000000  # 0.0  (ZZ[63])
i32 call.effective_steps 10
