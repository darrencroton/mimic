# Stripped gas exceeds the satellite's hot gas: gas and metals are clamped to the reservoir.
format sage26-oracle-fixture 1
routine strip_from_satellite

i32 params.ReionizationOn 1
i32 params.CGMrecipeOn 0
f64 params.BaryonFrac 0x3fc5c28f5c28f5c3  # 0.17000000000000001
f64 params.a0 0x3fbc71c71c71c71c  # 0.1111111111111111  (1/(1+Reionization_z0), z0 = 8)
f64 params.ar 0x3fc0000000000000  # 0.125  (1/(1+Reionization_zr), zr = 7)
f64 params.Omega 0x3fd0000000000000  # 0.25
f64 params.OmegaLambda 0x3fe8000000000000  # 0.75
f64 params.Hubble 0x40590001165723b7  # 100.00006636151998  (HUBBLE * UnitTime_in_s)
f64 params.G 0x404580e7ed5ced1b  # 43.007077856420629  (GRAVITY / CUBE(L) * M * SQR(T))

i32 call.ngal 2
i32 call.centralgal 0
i32 call.satellite 1
f64 call.Zcurr 0x0000000000000000  # 0
i32 call.effective_steps 1

i32 galaxy[0].Type 0
f32 galaxy[0].Mvir 0x42a00000  # 80
f32 galaxy[0].StellarMass 0x3f800000  # 1
f32 galaxy[0].ColdGas 0x3f000000  # 0.5
f32 galaxy[0].HotGas 0x41000000  # 8
f32 galaxy[0].MetalsHotGas 0x3da3d70a  # 0.0799999982
f32 galaxy[0].CGMgas 0x00000000  # 0
f32 galaxy[0].MetalsCGMgas 0x00000000  # 0
f32 galaxy[0].EjectedMass 0x3f000000  # 0.5
f32 galaxy[0].BlackHoleMass 0x3b03126f  # 0.00200000009
f32 galaxy[0].ICS 0x3dcccccd  # 0.100000001

i32 galaxy[1].Type 1
f32 galaxy[1].Mvir 0x40400000  # 3
f32 galaxy[1].StellarMass 0x3e99999a  # 0.300000012
f32 galaxy[1].ColdGas 0x3dcccccd  # 0.100000001
f32 galaxy[1].HotGas 0x3c23d70a  # 0.00999999978
f32 galaxy[1].MetalsHotGas 0x38d1b717  # 9.99999975e-05
f32 galaxy[1].CGMgas 0x00000000  # 0
f32 galaxy[1].MetalsCGMgas 0x00000000  # 0
f32 galaxy[1].EjectedMass 0x3ca3d70a  # 0.0199999996
f32 galaxy[1].BlackHoleMass 0x3a03126f  # 0.000500000024
f32 galaxy[1].ICS 0x00000000  # 0
