# Stripping with the satellite in Regime 1 (source: its hot pair, I:250, :253-254) and the FoF
# central in Regime 0 (destination: its CGM pair, I:251, :265-271), the gas cap binding (I:259).
# The unselected pairs of both galaxies are unchanged; the destination metals are credited the
# capped gas times the original metallicity (I:267, :270).
# Reachability: R4-reachable state (constructed values): satellites keep both pairs (R4 Snap_32: 11
# CGM-regime and 13 hot-regime satellites hold both).
# R4's flags: CGMrecipeOn 1 (par/R4.par:54); ReionizationOn 1, BaryonFrac 0.17,
# ReIncorporationFactor 0.19 and Reionization_z0/zr 8/7 as R3 (R4.par:51, :39, :72, :85-86).
format sage26-oracle-fixture 1
routine strip_from_satellite

i32 params.ReionizationOn 1
i32 params.CGMrecipeOn 1
f64 params.BaryonFrac 0x3fc5c28f5c28f5c3  # 0.17000000000000001
f64 params.a0 0x3fbc71c71c71c71c  # 0.1111111111111111  (1/(1+Reionization_z0), z0 = 8)
f64 params.ar 0x3fc0000000000000  # 0.125  (1/(1+Reionization_zr), zr = 7)
f64 params.Omega 0x3fd0000000000000  # 0.25
f64 params.OmegaLambda 0x3fe8000000000000  # 0.75
f64 params.Hubble 0x40590001165723b7  # 100.00006636151998  (HUBBLE * UnitTime_in_s)
f64 params.G 0x404580e7ed5ced1b  # 43.007077856420629  (GRAVITY / CUBE(L) * M * SQR(T))

i32 call.ngal 2
i32 call.centralgal 0
i32 call.satellite 1
f64 call.Zcurr 0x0000000000000000  # 0.0  (z = 0)
i32 call.effective_steps 10
# galaxy[0]: Type 0 FoF central, Regime 0, both pairs non-empty

i32 galaxy[0].Type 0
i32 galaxy[0].Regime 0
f32 galaxy[0].Mvir 0x43480000  # 200
f32 galaxy[0].StellarMass 0x40400000  # 3
f32 galaxy[0].ColdGas 0x3f800000  # 1
f32 galaxy[0].HotGas 0x40800000  # 4
f32 galaxy[0].MetalsHotGas 0x3d23d70a  # 0.0399999991
f32 galaxy[0].CGMgas 0x40000000  # 2
f32 galaxy[0].MetalsCGMgas 0x3cf5c28f  # 0.0299999993
f32 galaxy[0].EjectedMass 0x3f000000  # 0.5
f32 galaxy[0].BlackHoleMass 0x3ca3d70a  # 0.0199999996
f32 galaxy[0].ICS 0x3e99999a  # 0.300000012
# galaxy[1]: Type 1 satellite, Regime 1, both pairs non-empty, source below the excess

i32 galaxy[1].Type 1
i32 galaxy[1].Regime 1
f32 galaxy[1].Mvir 0x40000000  # 2
f32 galaxy[1].StellarMass 0x3fe66666  # 1.79999995
f32 galaxy[1].ColdGas 0x3e99999a  # 0.300000012
f32 galaxy[1].HotGas 0x3d4ccccd  # 0.0500000007
f32 galaxy[1].MetalsHotGas 0x3a03126f  # 0.000500000024
f32 galaxy[1].CGMgas 0x3f19999a  # 0.600000024
f32 galaxy[1].MetalsCGMgas 0x3c449ba6  # 0.0120000001
f32 galaxy[1].EjectedMass 0x3dcccccd  # 0.100000001
f32 galaxy[1].BlackHoleMass 0x3c23d70a  # 0.00999999978
f32 galaxy[1].ICS 0x3d4ccccd  # 0.0500000007
