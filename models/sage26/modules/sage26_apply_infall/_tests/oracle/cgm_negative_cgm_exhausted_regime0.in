# Negative infall that exhausts the ejected gas and then the CGM gas: the metal debit floors at zero
# (I:379) and the negative gas clears both selected fields (I:384).
# Reachability: R4-reachable state (constructed values).
# R4's flags: CGMrecipeOn 1 (par/R4.par:54); ReionizationOn 1, BaryonFrac 0.17,
# ReIncorporationFactor 0.19 and Reionization_z0/zr 8/7 as R3 (R4.par:51, :39, :72, :85-86).
format sage26-oracle-fixture 1
routine add_infall_to_hot

i32 params.CGMrecipeOn 1

f64 call.InfallingGas 0xc03e000000000000  # -30.0  (the snapshot budget infall_recipe returned)
i32 call.effective_steps 10
i32 galaxy[0].Type 0
i32 galaxy[0].Regime 0
f32 galaxy[0].EjectedMass 0x3dcccccd  # 0.100000001
f32 galaxy[0].MetalsEjectedMass 0x3a83126f  # 0.00100000005
f32 galaxy[0].HotGas 0x40000000  # 2
f32 galaxy[0].MetalsHotGas 0x3ca3d70a  # 0.0199999996
f32 galaxy[0].CGMgas 0x3fc00000  # 1.5
f32 galaxy[0].MetalsCGMgas 0x3c75c28f  # 0.0149999997
