# Threshold: the per-substep share is exactly minus the hot gas, so HotGas becomes exactly +0 and
# HotGas < 0 fails (:412); the float metallicity rounds down, so a small positive metal residue
# (~2.3e-10) stays in MetalsHotGas. A guard of HotGas <= 0 would zero it.
format sage26-oracle-fixture 1
routine add_infall_to_hot

i32 params.CGMrecipeOn 0

f64 call.InfallingGas 0xc008000000000000  # -3  (the snapshot budget infall_recipe returned)
i32 call.effective_steps 1
i32 galaxy[0].Type 0
f32 galaxy[0].EjectedMass 0x00000000  # 0
f32 galaxy[0].MetalsEjectedMass 0x00000000  # 0
f32 galaxy[0].HotGas 0x40400000  # 3
f32 galaxy[0].MetalsHotGas 0x3c23d70a  # 0.00999999978
