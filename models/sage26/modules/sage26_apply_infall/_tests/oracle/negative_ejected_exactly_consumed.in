# Threshold: the per-substep share is exactly minus the ejected gas, so EjectedMass becomes exactly
# 0 and EjectedMass < 0 fails (R/src/model_infall.c:363): the remaining infall is 0 and the
# rounding residue of the ejected metal debit is kept, not zeroed.
format sage26-oracle-fixture 1
routine add_infall_to_hot

i32 params.CGMrecipeOn 0

f64 call.InfallingGas 0xbfe3333340000000  # -0.60000002384185791  (the snapshot budget infall_recipe returned)
i32 call.effective_steps 1
i32 galaxy[0].Type 0
f32 galaxy[0].EjectedMass 0x3f19999a  # 0.600000024
f32 galaxy[0].MetalsEjectedMass 0x3bdb8bac  # 0.00669999979
f32 galaxy[0].HotGas 0x40400000  # 3
f32 galaxy[0].MetalsHotGas 0x3cf5c28f  # 0.0299999993
