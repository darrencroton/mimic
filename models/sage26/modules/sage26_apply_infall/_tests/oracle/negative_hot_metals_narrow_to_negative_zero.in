# Signed-zero edge (constructed; R0 never produces it): the hot metal debit
# MetalsHotGas + share * metallicity is a tiny nonzero negative double that narrows to float
# -0.0. SAGE26's strict floor (MetalsHotGas < 0.0, R/src/model_infall.c:407) keeps -0.0; a
# non-strict floor would rewrite it as +0. Share and metals are exact bit patterns.
format sage26-oracle-fixture 1
routine add_infall_to_hot

i32 params.CGMrecipeOn 0

f64 call.InfallingGas 0xc007fffff4000007  # -2.9999999105930359  (the snapshot budget infall_recipe returned)
i32 call.effective_steps 1
i32 galaxy[0].Type 0
f32 galaxy[0].EjectedMass 0x00000000  # 0
f32 galaxy[0].MetalsEjectedMass 0x00000000  # 0
f32 galaxy[0].HotGas 0x40400000  # 3
f32 galaxy[0].MetalsHotGas 0x0b800000  # 4.93038066e-32
