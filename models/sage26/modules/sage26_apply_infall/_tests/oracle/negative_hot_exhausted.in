# Negative budget larger than the hot gas: hot metals floor at 0 (:407), then HotGas < 0 zeroes
# both (:412).
format sage26-oracle-fixture 1
routine add_infall_to_hot

i32 params.CGMrecipeOn 0

f64 call.InfallingGas 0xc014000000000000  # -5  (the snapshot budget infall_recipe returned)
i32 call.effective_steps 1
i32 galaxy[0].Type 0
f32 galaxy[0].EjectedMass 0x00000000  # 0
f32 galaxy[0].MetalsEjectedMass 0x00000000  # 0
f32 galaxy[0].HotGas 0x40400000  # 3
f32 galaxy[0].MetalsHotGas 0x3cf5c28f  # 0.0299999993
