# Real central after its real infall_recipe call: the budget and the central's post-consolidation
# ejected and hot reservoirs are the oracle output r0_snap32_group.out of
# sage26_prepare_infall_budget, whose galaxy[0] is R0 reference model_0.hdf5 (SHA-256 6d859a3a2ea422e3...), Snap_32 row 0, GalaxyIndex 0: end-of-snapshot output values used as plausible call inputs, not reconstructed call-time state.
# effective_steps from R/src/core_build_model.c:430-459 with this central's Rvir/Vvir and a
# plausible deltaT (scipy lookback times for ZZ[31] and ZZ[32]).
format sage26-oracle-fixture 1
routine add_infall_to_hot

i32 params.CGMrecipeOn 0

f64 call.InfallingGas 0x3ec34fe718bed674  # 2.3021841055414412e-06  (the snapshot budget infall_recipe returned)
i32 call.effective_steps 10
i32 galaxy[0].Type 0
f32 galaxy[0].EjectedMass 0x3ccabe25  # 0.0247488711
f32 galaxy[0].MetalsEjectedMass 0x383cbdf0  # 4.4999586e-05
f32 galaxy[0].HotGas 0x425c64a6  # 55.0982895
f32 galaxy[0].MetalsHotGas 0x3dcd419b  # 0.100222789
