# Hot metals above hot gas: get_metallicity caps the metallicity at 1.
format sage26-oracle-fixture 1
routine add_infall_to_hot

i32 params.CGMrecipeOn 0

f64 call.InfallingGas 0xbfe0000000000000  # -0.5  (the snapshot budget infall_recipe returned)
i32 call.effective_steps 10
i32 galaxy[0].Type 0
f32 galaxy[0].EjectedMass 0x00000000  # 0
f32 galaxy[0].MetalsEjectedMass 0x00000000  # 0
f32 galaxy[0].HotGas 0x3e4ccccd  # 0.200000003
f32 galaxy[0].MetalsHotGas 0x3e99999a  # 0.300000012
