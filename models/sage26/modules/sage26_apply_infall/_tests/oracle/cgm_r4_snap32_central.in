# Real central after its real infall_recipe call: the budget and the central's post-consolidation
# reservoirs are the oracle output of cgm_r4_snap32_group (sage26_prepare_infall_budget), whose
# galaxy[0] is R4 Snap_32 row 26830, GalaxyIndex 5000115000000000. effective_steps 10 is plausible.
# Real halo values from the R4 reference output,
# /Volumes/Internal/results/sage26-campaign/workspace/e01-reference/out/R4/model_0.hdf5 (SHA-256
# 2b606ee7ac82559e32c7c91161f1edb44f89288ec57016e80da884e118ed0807), Snap_32: end-of-snapshot output
# values used as plausible call inputs, not reconstructed call-time state. Zcurr = ZZ[32] from the
# file header.
# Reachability: R4-reachable.
# R4's flags: CGMrecipeOn 1 (par/R4.par:54); ReionizationOn 1, BaryonFrac 0.17,
# ReIncorporationFactor 0.19 and Reionization_z0/zr 8/7 as R3 (R4.par:51, :39, :72, :85-86).
format sage26-oracle-fixture 1
routine add_infall_to_hot

i32 params.CGMrecipeOn 1

f64 call.InfallingGas 0xbea6eec01744e6cc  # -6.834452919497854e-07  (the snapshot budget infall_recipe returned)
i32 call.effective_steps 10
i32 galaxy[0].Type 0
i32 galaxy[0].Regime 0
f32 galaxy[0].EjectedMass 0x3ccb4e0a  # 0.0248174854
f32 galaxy[0].MetalsEjectedMass 0x3973944d  # 0.000232295322
f32 galaxy[0].HotGas 0x00000000  # 0
f32 galaxy[0].MetalsHotGas 0x00000000  # 0
f32 galaxy[0].CGMgas 0x3fba41b5  # 1.45513022
f32 galaxy[0].MetalsCGMgas 0x3c8623e8  # 0.0163745433
