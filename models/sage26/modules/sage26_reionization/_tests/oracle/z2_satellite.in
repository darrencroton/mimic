# Satellite (Type 1): do_reionization reads the satellite's own Mvir.
format sage26-oracle-fixture 1
routine do_reionization

f64 params.a0 0x3fbc71c71c71c71c  # 0.1111111111111111  (1/(1+Reionization_z0), z0 = 8)
f64 params.ar 0x3fc0000000000000  # 0.125  (1/(1+Reionization_zr), zr = 7)
f64 params.Omega 0x3fd0000000000000  # 0.25
f64 params.OmegaLambda 0x3fe8000000000000  # 0.75
f64 params.Hubble 0x40590001165723b7  # 100.00006636151998  (HUBBLE * UnitTime_in_s)
f64 params.G 0x404580e7ed5ced1b  # 43.007077856420629  (GRAVITY / CUBE(L) * M * SQR(T))
f64 params.BaryonFrac 0x3fc5c28f5c28f5c3  # 0.17000000000000001

f64 call.Zcurr 0x4000000000000000  # 2
i32 galaxy[0].Type 1
f32 galaxy[0].Mvir 0x40a00000  # 5
