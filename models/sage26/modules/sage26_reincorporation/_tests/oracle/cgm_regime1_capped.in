# A Regime 1 central whose reincorporation exceeds its ejected gas: the cap binds (G:54-55), all of
# it goes to the hot pair.
# Reachability: R4-reachable state (constructed values).
# R4's flags: CGMrecipeOn 1 (par/R4.par:54); ReionizationOn 1, BaryonFrac 0.17,
# ReIncorporationFactor 0.19 and Reionization_z0/zr 8/7 as R3 (R4.par:51, :39, :72, :85-86).
format sage26-oracle-fixture 1
routine reincorporate_gas

f64 params.ReIncorporationFactor 0x3fc851eb851eb852  # 0.19
i32 params.CGMrecipeOn 1

f64 call.Age_galaxy_snap 0x3f8308d4f9b0ed12  # 0.009294189329116995  (Age[galaxies[p].SnapNum])
f64 call.halo_age 0x3f82db2ad5054923  # 0.009207090974687809  (Age[halo_snapnum])
i32 call.effective_steps 1
i32 galaxy[0].Type 0
i32 galaxy[0].Regime 1
f32 galaxy[0].Vvir 0x44160000  # 600
f32 galaxy[0].Rvir 0x3d4ccccd  # 0.0500000007
f32 galaxy[0].EjectedMass 0x3f19999a  # 0.600000024
f32 galaxy[0].MetalsEjectedMass 0x3bc49ba6  # 0.00600000005
f32 galaxy[0].HotGas 0x40400000  # 3
f32 galaxy[0].MetalsHotGas 0x3cf5c28f  # 0.0299999993
f32 galaxy[0].CGMgas 0x40000000  # 2
f32 galaxy[0].MetalsCGMgas 0x3ccccccd  # 0.0250000004
