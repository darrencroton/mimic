# A Regime 0 central above Vcrit: the reincorporated gas and its metals go to its CGM pair through
# add_gas_to_hot_reservoir (G:64, X:76-85); the other pair is unchanged; the cap does not bind.
# Reachability: R4-reachable state (constructed values).
# R4's flags: CGMrecipeOn 1 (par/R4.par:54); ReionizationOn 1, BaryonFrac 0.17,
# ReIncorporationFactor 0.19 and Reionization_z0/zr 8/7 as R3 (R4.par:51, :39, :72, :85-86).
format sage26-oracle-fixture 1
routine reincorporate_gas

f64 params.ReIncorporationFactor 0x3fc851eb851eb852  # 0.19
i32 params.CGMrecipeOn 1

f64 call.Age_galaxy_snap 0x3f29c5a70839ce61  # 0.00019662536589103426  (Age[galaxies[p].SnapNum])
f64 call.halo_age 0x0000000000000000  # 0.0  (Age[halo_snapnum])
i32 call.effective_steps 10
i32 galaxy[0].Type 0
i32 galaxy[0].Regime 0
f32 galaxy[0].Vvir 0x44064000  # 537
f32 galaxy[0].Rvir 0x3f0978d5  # 0.537
f32 galaxy[0].EjectedMass 0x3e6147ae  # 0.219999999
f32 galaxy[0].MetalsEjectedMass 0x3992ccf7  # 0.000280000007
f32 galaxy[0].HotGas 0x40a00000  # 5
f32 galaxy[0].MetalsHotGas 0x3d4ccccd  # 0.0500000007
f32 galaxy[0].CGMgas 0x40400000  # 3
f32 galaxy[0].MetalsCGMgas 0x3d23d70a  # 0.0399999991
