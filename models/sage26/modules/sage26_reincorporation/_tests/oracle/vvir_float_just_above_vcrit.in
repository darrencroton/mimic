# Vvir = the smallest float above the double Vcrit (it equals (float)Vcrit, which rounds up):
# Vvir > Vcrit holds (threshold) and a reincorporated mass of ~3e-10 lands in the empty HotGas, so
# the output differs from the guard-not-taken outcome (a comparison against (float)Vcrit with >
# leaves HotGas 0). The ejected reservoir does not resolve the debit at float precision.
format sage26-oracle-fixture 1
routine reincorporate_gas

f64 params.ReIncorporationFactor 0x3fc851eb851eb852  # 0.19
i32 params.CGMrecipeOn 0

f64 call.Age_galaxy_snap 0x3f29c5a70839ce61  # 0.00019662536589103426  (Age[galaxies[p].SnapNum])
f64 call.halo_age 0x0000000000000000  # 0  (Age[halo_snapnum])
i32 call.effective_steps 10
i32 galaxy[0].Type 0
f32 galaxy[0].Vvir 0x4286b8ae  # 67.3607025
f32 galaxy[0].Rvir 0x3dcccccd  # 0.100000001
f32 galaxy[0].EjectedMass 0x3f19999a  # 0.600000024
f32 galaxy[0].MetalsEjectedMass 0x3bc49ba6  # 0.00600000005
f32 galaxy[0].HotGas 0x00000000  # 0
f32 galaxy[0].MetalsHotGas 0x00000000  # 0
