# rcool == Rvir exactly (C:193 `rcool > Rvir` false: static branch). Constructed by a search
# for float Vvir, Rvir and HotGas (MetalsHotGas 0) whose rcool equals the widened Rvir;
# intermediate.rcool and RcoolToRvir (1.0) in the output show the equality.
# 0 < r_heat < rcool and Heating prior 0, so rcool and x can be validated.
# Diagnostics tcool, tff, RcoolToRvir, CoolingRate, Cooling and Heating are set to negative bit patterns no routine here writes, unless a comment says otherwise.
format sage26-oracle-fixture 1
routine cooling_recipe_hot

i32 params.AGNrecipeOn 2  # R0 (the oracle's fixed flag)
i32 params.CGMrecipeOn 0  # R0 (the oracle's fixed flag)
f64 params.G 0x404580e7ed5ced1b  # 43.007077856420629  (GRAVITY / CUBE(L) * M * SQR(T))
f64 params.RadioModeEfficiency 0x3fb47ae147ae147b  # 0.080000000000000002  (R/input/millennium.par:74)
f64 params.Hubble_h 0x3fe75c28f5c28f5c  # 0.72999999999999998  (R/input/millennium.par:40)
f64 params.UnitEnergy_in_cgs 0x4b009ce7388de074  # 1.9890000000000001e+53  (M * SQR(L) / SQR(T))
f64 params.UnitTime_in_s 0x43fac39601d1945f  # 3.0856799999999996e+19  (L / V)
f64 params.UnitDensity_in_cgs 0x39ab764398088fc8  # 6.7698980144406312e-31  (M / CUBE(L))

f64 call.Age_galaxy_snap 0x3f50624dd2f1a9fc  # 0.001  (Age[galaxies[p].SnapNum])
f64 call.halo_age 0x0000000000000000  # 0  (Age[halo_snapnum])
i32 call.effective_steps 10
i32 galaxy[0].Type 0
f32 galaxy[0].Mvir 0x42700000  # 60
f32 galaxy[0].Rvir 0x3d9b240d  # 0.0757523552
f32 galaxy[0].Vvir 0x43520000  # 210
f32 galaxy[0].HotGas 0x42440e10  # 49.0137329
f32 galaxy[0].MetalsHotGas 0x00000000  # 0
f32 galaxy[0].ColdGas 0x40000000  # 2
f32 galaxy[0].MetalsColdGas 0x3cf5c28f  # 0.0299999993
f32 galaxy[0].BlackHoleMass 0x3c23d70a  # 0.00999999978
f32 galaxy[0].r_heat 0x3ca3d70a  # 0.0199999996
f64 galaxy[0].Cooling 0xc04b800000000000  # -55  (input bit pattern no routine here writes)
f64 galaxy[0].Heating 0x0000000000000000  # 0
f32 galaxy[0].tcool 0xc1300000  # -11  (input bit pattern no routine here writes)
f32 galaxy[0].tff 0xc1b00000  # -22  (input bit pattern no routine here writes)
f32 galaxy[0].RcoolToRvir 0xc2040000  # -33  (input bit pattern no routine here writes)
f32 galaxy[0].CoolingRate 0xc2300000  # -44  (input bit pattern no routine here writes)
