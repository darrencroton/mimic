# Executables
mimic

# Data and results
input/data
/output
simulations/*/snapshots
!tests/data/output/
!tests/data/output/baseline/
!tests/data/output/baseline/**

# Benchmark results
benchmarks

# Archive and scratch space
archive
obsidian-inbox
sage-code

# Machine-local operational scripts (cluster-specific paths/accounts, not portable
# project source - e.g. per-cluster SLURM job scripts)
ops/

# Slurm job logs (%x-%j.out/.err land in the submission directory, i.e. repo root -
# untracked, so a cleanliness guard like ops/nt/sage16_shin-uchuu.sbatch's own
# "working tree is not clean" check doesn't trip on a job's own just-created logs)
/*.out
/*.err

# Build artifacts
build/
*.o
*.d

# Generated files
src/include/generated/
src/module_system/generated/
tests/generated/
plot/mimic-plot/generated/
docs/generated/module-reference.md

# Test artifacts
tests/unit/build/
tests/data/output/binary/
tests/data/output/hdf5/
tests/data/output/tree_preservation_report.md

# Editor artifacts
*.*~
*.swp
*.swo
*~

# IDE files
.vscode/
.idea/
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class

# Claude Code session data
.claude/
.ai-orchestrator/
.orchestrator/
.pm

