// Markdown structure checks. beautify.sh and `make check-format` own C/Python
// formatting; this owns Markdown only. A project config replaces the lint
// skill's defaults rather than merging, so every needed disable is listed here.
{
  "config": {
    "default": true,

    // Mimic does not hard-wrap prose (docs/STYLE-GUIDE.md); 100 chars is a
    // code-block guideline only.
    "MD013": false,

    // Mimic writes lists under a bold lead-in or heading, and fences under
    // their introducing sentence. Verified against markdown-it (the parser
    // markdownlint bundles): all three render correctly, so these are cosmetic.
    "MD022": false, // blanks-around-headings
    "MD032": false, // blanks-around-lists
    "MD031": false, // blanks-around-fences

    // Cosmetic marker and whitespace styles.
    "MD004": false, // ul-style
    "MD007": false, // ul-indent
    "MD012": false, // consecutive blank lines
    "MD029": false, // ordered-list numbering
    "MD030": false, // spaces after marker
    "MD035": false, // hr style
    "MD046": false, // code-block style
    "MD048": false, // code-fence style
    "MD049": false, // emphasis style
    "MD050": false, // strong style
    "MD060": false, // table pipe spacing

    // Implementation plans repeat "### Validation Plan" once per slice by
    // design, so duplicate headings are structural.
    "MD024": false,
    "MD003": false, // heading style
    "MD033": false, // inline HTML
    "MD036": false, // emphasis as heading
    "MD041": false, // first line must be a heading
    "MD044": false  // proper-name capitalisation (needs a word list)

    // Left on: MD040 (untagged fences lose highlighting), MD034 (bare URLs do
    // not autolink outside GFM), MD056/MD058 (a malformed table drops data),
    // MD011/MD039/MD042, MD025/MD001, MD009/MD047.
  },

  // Mirrors what scripts/check_docs.py skips. Without these, `**/*.md` follows
  // the gitignored obsidian-inbox symlink out of the repository.
  "globs": ["**/*.md"],
  "ignores": [
    "mimic_venv/**",
    "node_modules/**",
    "**/node_modules/**",
    "archive/**",
    "output/**",
    "obsidian-inbox/**",
    "sage-code/**",
    ".orchestrator/**",
    ".ai-orchestrator/**",
    ".pm/**",
    "tests/data/output/tree_preservation_report.md" // generated by tests
  ]
}
